{
  "name": "jianqiankan-workbench",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:workbench": "vite build --config workbench/vite.config.ts",
    "start:workbench": "node tools/start-release.mjs",
    "workbench:task": "node --import tsx workbench/handoff.ts",
    "type-check": "vue-tsc -p workbench/tsconfig.json",
    "test:release": "node tools/verify-hair-workbench.mjs --directory . --no-browser",
    "test:analysis": "node --import tsx --test workbench/test-portable-analysis.mjs",
    "test:colors": "node --import tsx workbench/test-color-planning.mjs",
    "test:codex": "node --import tsx --test workbench/test-codex-platform.mjs"
  },
  "dependencies": {
    "sharp": "0.34.4",
    "tsx": "4.20.6",
    "@vladmandic/human": "3.3.5",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "4.9.5",
    "vite": "5.2.8",
    "vue": "3.4.21",
    "vue-tsc": "1.8.27"
  }
}
